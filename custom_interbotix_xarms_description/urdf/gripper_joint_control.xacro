<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gripper_joint_control_description" params="tf_prefix initial_positions">
        <joint name="${tf_prefix}gripper">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper']}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${tf_prefix}left_finger">
            <state_interface name="position">
                <param name="initial_value">0.015</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${tf_prefix}right_finger">
            <state_interface name="position">
                <param name="initial_value">0.015</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>
    
</robot>