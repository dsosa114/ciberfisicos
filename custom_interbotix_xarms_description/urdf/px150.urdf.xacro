<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="px150">
    <xacro:include filename="$(find custom_interbotix_xarms_description)/urdf/arm.xacro" />
    <xacro:include filename="$(find custom_interbotix_xarms_description)/urdf/gripper.xacro" />
    <xacro:include filename="$(find custom_interbotix_xarms_description)/urdf/px150_arm_ros2_control.xacro" />

    <xacro:arg name="tf_prefix" default="" />
    <xacro:arg name="use_world_frame" default="true" />
    <xacro:arg name="fixed_frame_name" default="" />

    <xacro:arg name="use_gripper" default="true" />
    <xacro:arg name="sim_gz" default="false" />

    <xacro:arg name="initial_positions_file" default="$(find custom_interbotix_xarms_description)/config/initial_positions.yaml"/>
    <!-- convert to property to use substitution in function -->
    <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>
    <xacro:property name="initial_positions_parameters" value="${xacro.load_yaml(initial_positions_file)}"/>
    <xacro:property name="initial_positions" value="${initial_positions_parameters['initial_positions']}"/>

    <xacro:property name="fixed_frame" value="$(arg fixed_frame_name)" />
    <xacro:if value="$(arg use_world_frame)">
        <link name="world"/>
        <xacro:property name="fixed_frame" value="world" />
    </xacro:if>
    
    <!-- Arm -->
    <xacro:arm fixed_frame="${fixed_frame}" tf_prefix="$(arg tf_prefix)"/>
    <!-- Gripper -->
    <xacro:if value="$(arg use_gripper)">
        <xacro:gripper tf_prefix="$(arg tf_prefix)" attach_link="ee_arm_link"/>
    </xacro:if>
    
    <xacro:arm_ros2_control name="px150_HardwareInterface" tf_prefix="$(arg tf_prefix)" initial_positions="${initial_positions}" sim_gz="$(arg sim_gz)" use_gripper="$(arg use_gripper)"/>

    <xacro:if value="$(arg sim_gz)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find custom_interbotix_xarms_description)/config/custom_arm_controllers.yaml</parameters>
                <xacro:if value="$(arg use_gripper)">
                    <parameters>$(find custom_interbotix_xarms_description)/config/custom_gripper_controllers.yaml</parameters>
                </xacro:if>              
            </plugin>
        </gazebo> 
    </xacro:if>
       
</robot>